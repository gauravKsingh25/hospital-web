# =============================================================================
# hospital-web — environment template (marketing site, static export)
# =============================================================================
# The website is a static export, so these are baked into the HTML when it is
# built; change them and rebuild. Neither is a secret.

# The hospital app's address; "Sign in" on the website links to <this>/login.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The website's own address, used to make the share image (og:image) absolute.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# The Nirogya API, which the contact form and signup call from the browser.
# This site's origin must be in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL="http://localhost:8000"
